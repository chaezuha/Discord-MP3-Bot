# Copy this file to .env and fill in your values.
# Never commit .env — it is ignored via .gitignore.

# Your bot token from https://discord.com/developers/applications (required)
DISCORD_TOKEN=

# Guild (server) ID to sync slash commands to for instant updates.
# Optional — leave unset/0 to sync globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=0

# Absolute path to the folder containing your .mp3 files (required).
# With Docker Compose this is the HOST folder — compose mounts it into the
# container at /music for you.
DISCORD_MUSIC_PATH=/absolute/path/to/your/mp3/folder

# Explicit path to libopus, only if your system does not auto-detect it.
# Optional — leave empty on most systems.
DISCORD_OPUS_PATH=
